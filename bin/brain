#!/usr/bin/env bash
# Run second-brain from any folder. It works on the brain in your current folder
# (or $BRAIN_HOME), so cd into your brain first.
set -euo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
TOOL="$(cd -P "$(dirname "$SRC")/.." && pwd)"
BIN="$TOOL/build/install/second-brain/bin/second-brain"

if [ ! -x "$BIN" ]; then
  echo "second-brain is not built. Run: (cd $TOOL && ./gradlew installDist)" >&2
  exit 2
fi
if [ -z "${JAVA_HOME:-}" ]; then
  for d in "$HOME"/.sdkman/candidates/java/27*; do [ -d "$d" ] && export JAVA_HOME="$d"; done
fi

export BRAIN_TOOL_DIR="$TOOL"
exec "$BIN" "$@"
